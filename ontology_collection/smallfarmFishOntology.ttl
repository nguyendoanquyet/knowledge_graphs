###  http://w3id.org/aqfo/aqfo_00002051
<http://w3id.org/aqfo/aqfo_00002051> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002018> ;
                                     obo:IAO_0000115 "A by-product of the dry milling industry to produce maize flour and grits for human consumption, unlike in industrialized countries where maize bran is mainly the by-product of ethanol and starch production. Hence, in developing countries, the maize bran contains testa, the germ and broken pieces of the endosperm. Maize bran is widely used as an ingredient in animal feeds, because of its low price and availability in many local market." ;
                                     dc:creator <http://orcid.org/0000-0002-8461-9745> ;
                                     rdfs:label "maize bran" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/aqfo_00002051> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A by-product of the dry milling industry to produce maize flour and grits for human consumption, unlike in industrialized countries where maize bran is mainly the by-product of ethanol and starch production. Hence, in developing countries, the maize bran contains testa, the germ and broken pieces of the endosperm. Maize bran is widely used as an ingredient in animal feeds, because of its low price and availability in many local market." ;
   oboInOwl:hasDbXref "Yossa, R., Ahmad Fatan, N., Fairchild, J., & Schrama, J. W. (2021). Apparent digestibility coefficients of local palm kernel cakes, rice bran, maize bran and sago flour in the GIFT strain of Nile tilapia (Oreochromis niloticus). Journal of Applied Aquaculture.;https://doi.org/10.1080/10454438.2020.1869635"
 ] .


###  http://w3id.org/aqfo/aqfo_00002052
<http://w3id.org/aqfo/aqfo_00002052> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002018> ;
                                     obo:IAO_0000115 "Is extracted from the pith located in the sago palm stem, below the lignified bark. The processing consists of drying the wet sago pith and then grinding it to produce fine particle sizes of the sago meal, which is primarily used in human nutrition, but there is a growing interest in using it as energy source in animal diets because of its high carbohydrate (>80% on dry matter basis) content." ;
                                     dc:creator <http://orcid.org/0000-0002-8461-9745> ;
                                     rdfs:label "sago flour" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/aqfo_00002052> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Is extracted from the pith located in the sago palm stem, below the lignified bark. The processing consists of drying the wet sago pith and then grinding it to produce fine particle sizes of the sago meal, which is primarily used in human nutrition, but there is a growing interest in using it as energy source in animal diets because of its high carbohydrate (>80% on dry matter basis) content." ;
   oboInOwl:hasDbXref "Yossa, R., Ahmad Fatan, N., Fairchild, J., & Schrama, J. W. (2021). Apparent digestibility coefficients of local palm kernel cakes, rice bran, maize bran and sago flour in the GIFT strain of Nile tilapia (Oreochromis niloticus). Journal of Applied Aquaculture.;https://doi.org/10.1080/10454438.2020.1869635"
 ] .


