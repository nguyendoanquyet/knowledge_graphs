###  http://w3id.org/aqfo/AQFO_00000002
<http://w3id.org/aqfo/AQFO_00000002> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002211> ;
                                     obo:IAO_0000115 "Fish stocking is the practice of releasing fish that are artificially raised in a hatchery into a natural body of water (river, lake or ocean), in order to supplement existing wild populations or to create a new population where previously none exists."@en ;
                                     dc:creator <http://orcid.org/0000-0001-9796-6159> ;
                                     dc:date "2023-11-28T07:02:14Z"^^xsd:dateTime ;
                                     rdfs:label "fish stocking"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/AQFO_00000002> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Fish stocking is the practice of releasing fish that are artificially raised in a hatchery into a natural body of water (river, lake or ocean), in order to supplement existing wild populations or to create a new population where previously none exists."@en ;
   oboInOwl:hasDbXref <https://en.wikipedia.org/wiki/Fish_stocking>
 ] .


###  http://w3id.org/aqfo/AQFO_00000003
<http://w3id.org/aqfo/AQFO_00000003> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002330> ;
                                     obo:IAO_0000115 "Branchiomycosis is a fungal infection; one of several serious and deadly infections that can affect a fish's gills. This particular infection is most often due to the environmental conditions of the water in which the fish are kept." ;
                                     dc:creator <http://orcid.org/0000-0001-9796-6159> ;
                                     dc:date "2023-12-06T03:12:44Z"^^xsd:dateTime ;
                                     oboInOwl:hasExactSynonym "Branchiomycosis" ;
                                     rdfs:label "gills rot"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/AQFO_00000003> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Branchiomycosis is a fungal infection; one of several serious and deadly infections that can affect a fish's gills. This particular infection is most often due to the environmental conditions of the water in which the fish are kept." ;
   oboInOwl:hasDbXref <https://www.petmd.com/fish/conditions/infectious-parasitic/c_fi_branchiomycosis>
 ] .


###  http://w3id.org/aqfo/AQFO_00005002
<http://w3id.org/aqfo/AQFO_00005002> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002269> ;
                                     obo:IAO_0000115 "Polyculture is the production of two or more cultured species in the same physical space at the same time, often with the objective of producing multiple products that have economic value. They may be a combination of animals, plants and animals, aquatic species only, or aquatic and terrestrial species." ;
                                     dc:creator "YHoong" ;
                                     dc:date "2023-11-28T07:04:36Z"^^xsd:dateTime ;
                                     rdfs:label "polyculture"@en .


