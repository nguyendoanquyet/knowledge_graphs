                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002242> ;
                                     obo:IAO_0000115 "Refers to the physical anomalies (e.g., fin, skeleton) of the catch that are usually caused by environmental pollutants, scarcity of nutrients, sudden changes in temperature, water current, gene mutation, inbreeding, parasitic infestation, and attack from predators. Deformed catches are often culled-out or sold at lower market value." ;
                                     dc:creator <http://orcid.org/0000-0002-8461-9745> ;
                                     oboInOwl:hasExactSynonym "catch abnormal phenotype" ;
                                     rdfs:label "catch deformity" .

