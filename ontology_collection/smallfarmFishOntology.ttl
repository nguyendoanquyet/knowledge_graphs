###  http://w3id.org/aqfo/aqfo_00002302
<http://w3id.org/aqfo/aqfo_00002302> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002276> ;
                                     obo:IAO_0000115 "Is a mechanism applied to collect and interpret data on the health of animal populations, to accurately describe their health status with respect to specific diseases of concern. This can be based on historic scientific evidence for absence, under certain circumstances, of clinical cases of a virulent disease of the susceptible species" ;
                                     dc:creator <http://orcid.org/0000-0002-8461-9745> ;
                                     rdfs:label "disease surveillance" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/aqfo_00002302> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Is a mechanism applied to collect and interpret data on the health of animal populations, to accurately describe their health status with respect to specific diseases of concern. This can be based on historic scientific evidence for absence, under certain circumstances, of clinical cases of a virulent disease of the susceptible species" ;
   oboInOwl:hasDbXref "Subasinghe, R. P., McGladdery, S. E. & Hill, B. J. (Eds.). (2004). Surveillance and zoning for aquatic animal diseases. Rome: FAO.;https://www.fao.org/3/y5325e/y5325e0b.htm#bm11"
 ] .


###  http://w3id.org/aqfo/aqfo_00002303
<http://w3id.org/aqfo/aqfo_00002303> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002302> ;
                                     obo:IAO_0000115 "A type of disease surveillance that involves planned collection of precise field data on the presence of a specific disease or pathogen within a defined population. Active disease surveillance programmes may be (i) “catch all” - aimed at detecting any significant disease occurrences; (ii) may target specific diseases; or (iii) may monitor the progress of specific disease control or eradication efforts. " ;
                                     dc:creator <http://orcid.org/0000-0002-8461-9745> ;
                                     oboInOwl:hasExactSynonym "targetted disease surveillnce" ;
                                     rdfs:label "active disease surveillance" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/aqfo_00002303> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A type of disease surveillance that involves planned collection of precise field data on the presence of a specific disease or pathogen within a defined population. Active disease surveillance programmes may be (i) “catch all” - aimed at detecting any significant disease occurrences; (ii) may target specific diseases; or (iii) may monitor the progress of specific disease control or eradication efforts. " ;
   oboInOwl:hasDbXref "Subasinghe, R. P., McGladdery, S. E. & Hill, B. J. (Eds.). (2004). Surveillance and zoning for aquatic animal diseases. Rome: FAO.;https://www.fao.org/3/y5325e/y5325e0b.htm#bm11"
 ] .


###  http://w3id.org/aqfo/aqfo_00002304
<http://w3id.org/aqfo/aqfo_00002304> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002302> ;
                                     obo:IAO_0000115 "Is an ongoing observation of the endemic disease profile of a susceptible population, so that unexpected and/or abnormal changes can be detected and acted upon as rapidly as possible. In addition, laboratory diagnostic data may be used to define a threshold level of undiagnosed syndromes which would trigger in-depth investigations to try and characterize them. For example, if gill disease in fish exceeded a given prevalence, this could trigger a diagnostic investigation to determine whether or not this is indicative of a \"new\" disease. Such surveillance of disease syndromes (common clinical signs) could also be collected by fisheries officers or harvesters/farmers." ;
                                     dc:creator <http://orcid.org/0000-0002-8461-9745> ;
                                     oboInOwl:hasExactSynonym "general surveillance" ;
                                     rdfs:label "passive disease surveillance" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/aqfo_00002304> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Is an ongoing observation of the endemic disease profile of a susceptible population, so that unexpected and/or abnormal changes can be detected and acted upon as rapidly as possible. In addition, laboratory diagnostic data may be used to define a threshold level of undiagnosed syndromes which would trigger in-depth investigations to try and characterize them. For example, if gill disease in fish exceeded a given prevalence, this could trigger a diagnostic investigation to determine whether or not this is indicative of a \"new\" disease. Such surveillance of disease syndromes (common clinical signs) could also be collected by fisheries officers or harvesters/farmers." ;
   oboInOwl:hasDbXref "Subasinghe, R. P., McGladdery, S. E. & Hill, B. J. (Eds.). (2004). Surveillance and zoning for aquatic animal diseases. Rome: FAO.;https://www.fao.org/3/y5325e/y5325e0b.htm#bm11"
 ] .


