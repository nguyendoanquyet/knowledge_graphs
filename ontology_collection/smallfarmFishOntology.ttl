   oboInOwl:hasDbXref "Demersal zone. (2021, Aug 7). Demersal zone. Wikipedia, the free encyclopedia.;https://en.wikipedia.org/wiki/Demersal_zone"
 ] .


###  http://w3id.org/aqfo/aqfo_00002184
<http://w3id.org/aqfo/aqfo_00002184> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002181> ;
                                     obo:IAO_0000115 "Ecological realm that includes the entire ocean water column. Of all the inhabited Earth environments, the pelagic zone has the largest volume, 1,370,000,000 cubic kilometres (330,000,000 cubic miles), and the greatest vertical range, 11,000 metres (36,000 feet)." ;
                                     dc:contributor <http://orcid.org/0000-0002-8461-9745> ;
                                     rdfs:label "pelagic zone" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/aqfo_00002184> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Ecological realm that includes the entire ocean water column. Of all the inhabited Earth environments, the pelagic zone has the largest volume, 1,370,000,000 cubic kilometres (330,000,000 cubic miles), and the greatest vertical range, 11,000 metres (36,000 feet)." ;
   oboInOwl:hasDbXref "The Editors of Encyclopaedia Britannica. (2020, Mar 06). Pelagic zone. Encyclopedia Britannica.;https://www.britannica.com/science/pelagic-zone"
 ] .


###  http://w3id.org/aqfo/aqfo_00002185
<http://w3id.org/aqfo/aqfo_00002185> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00000026> ,
                                                     <http://w3id.org/aqfo/aqfo_00002181> ,
                                                     <http://w3id.org/aqfo/aqfo_00002186> ;
                                     obo:IAO_0000115 "A tidal salt marsh (intertidal) community dominated by trees and shrubs, particularly of the genus Rhizophora, many of which produce adventitious aerial roots. Develops in tropical and subtropical areas, in predominantly muddy or sandy substrates, and along protected coastlines. It produces both forest and fisheries resources and goods. " ;
                                     dc:contributor <http://orcid.org/0000-0002-8461-9745> ;
                                     dcterms:creator <https://orcid.org/0000-0002-6363-0945> ;
                                     rdfs:label "mangrove" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/aqfo_00002185> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A tidal salt marsh (intertidal) community dominated by trees and shrubs, particularly of the genus Rhizophora, many of which produce adventitious aerial roots. Develops in tropical and subtropical areas, in predominantly muddy or sandy substrates, and along protected coastlines. It produces both forest and fisheries resources and goods. " ;
   oboInOwl:hasDbXref "FAO term portal. (2021). Rome: FAO.;https://www.fao.org/faoterm/collection/fisheries/en/"
 ] .


