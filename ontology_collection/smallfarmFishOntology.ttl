###  http://w3id.org/aqfo/aqfo_00002267
<http://w3id.org/aqfo/aqfo_00002267> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002195> ;
                                     obo:IAO_0000115 "First step in the oxidation of the ammonia excreted by aquatic organisms as the end product of the protein metabolism. It inhibits the uptake of oxygen by haemoglobin and is thus toxic to fish. Crustaceans are affected to a lesser extend as haemoglobin is only partially inhibited. For a given concentration therefore, nitrite is usually more toxic in freshwater than in brackish or seawater. " ;
                                     dc:creator <http://orcid.org/0000-0002-8461-9745> ;
                                     rdfs:label "water nitrite" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/aqfo_00002267> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "First step in the oxidation of the ammonia excreted by aquatic organisms as the end product of the protein metabolism. It inhibits the uptake of oxygen by haemoglobin and is thus toxic to fish. Crustaceans are affected to a lesser extend as haemoglobin is only partially inhibited. For a given concentration therefore, nitrite is usually more toxic in freshwater than in brackish or seawater. " ;
   oboInOwl:hasDbXref "FAO term portal. (2021). Rome: FAO.;https://www.fao.org/faoterm/collection/fisheries/en/"
 ] .


