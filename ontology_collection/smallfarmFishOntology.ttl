                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002211> ;
                                     obo:IAO_0000115 "the activity of trying to catch fish. The term fishing broadly includes catching aquatic animals other than fish, such as crustaceans (shrimp/lobsters/crabs), shellfish, cephalopods (octopus/squid) and echinoderms (starfish/sea urchins)."@en ;
                                     dc:creator <https://orcid.org/0009-0001-6183-0388> ;
                                     dc:date "2024-03-27T02:31:53Z"^^xsd:dateTime ;
                                     rdfs:label "fishing"@en .

