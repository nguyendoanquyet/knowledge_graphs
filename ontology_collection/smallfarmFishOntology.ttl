                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002018> ;
                                     obo:IAO_0000115 "It is a cereal, belonging to the family Poaceae. Of the total world production about 30% are consumed by man and the remaining 70% are used as feedstuffs. It has been utilized as one of the ingredients for the feeds of aquatic organisms." ;
                                     dc:creator <http://orcid.org/0000-0002-8461-9745> ;
                                     oboInOwl:hasExactSynonym "maize" ;
                                     rdfs:label "corn" .

