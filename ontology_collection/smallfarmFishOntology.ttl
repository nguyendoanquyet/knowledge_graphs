###  http://w3id.org/aqfo/aqfo_00000005
<http://w3id.org/aqfo/aqfo_00000005> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002220> ;
                                     obo:IAO_0000115 "A spear gun is an underwater fishing implement designed to fire a spear at marine organisms. The basic components of a spear gun are: A spear, a stock/barrel, and a handle/grip containing a trigger mechanism. Spear guns are usually from .5 m to 2 m (1.5 ft to 6.5 ft) long, round or roughly rectangular from 28 mm - 75 mm (1 in to 3 in) in diameter/width. The two most common types of spear propulsion are: Rubber (or elastic band) powered and air powered (Pneumatic)." ;
                                     dc:creator <http://orcid.org/0000-0002-2789-1558> ;
                                     dcterms:creator <https://orcid.org/0000-0002-6363-0945> ;
                                     rdfs:label "speargun" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/aqfo_00000005> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A spear gun is an underwater fishing implement designed to fire a spear at marine organisms. The basic components of a spear gun are: A spear, a stock/barrel, and a handle/grip containing a trigger mechanism. Spear guns are usually from .5 m to 2 m (1.5 ft to 6.5 ft) long, round or roughly rectangular from 28 mm - 75 mm (1 in to 3 in) in diameter/width. The two most common types of spear propulsion are: Rubber (or elastic band) powered and air powered (Pneumatic)." ;
   oboInOwl:hasDbXref "Diving. https://fishingbooker.com/blog/spearfishing-for-beginners-the-complete-guide/; ;"
 ] .


###  http://w3id.org/aqfo/aqfo_00000007
<http://w3id.org/aqfo/aqfo_00000007> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002232> ;
                                     obo:IAO_0000115 "A type of monofilament net used in various gears so-called because it entangles fish predominantly at their gill openings (opercula).  According to their design, ballasting and buoyancy, these nets may be used to fish on the surface, in midwater or on the bottom, fixed or drifting, and may be combined together in various designs." ;
                                     dc:creator <http://orcid.org/0000-0002-2789-1558> ;
                                     dcterms:creator <https://orcid.org/0000-0002-6363-0945> ;
                                     rdfs:label "gill net" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/aqfo_00000007> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A type of monofilament net used in various gears so-called because it entangles fish predominantly at their gill openings (opercula).  According to their design, ballasting and buoyancy, these nets may be used to fish on the surface, in midwater or on the bottom, fixed or drifting, and may be combined together in various designs." ;
   oboInOwl:hasDbXref "Blackhart, K., Stanton, D. G., & Shimada, A. M. (2006). NOAA fisheries glossary (Revised edition). Silver Spring, MD: United States Department of Commerce, National Oceanic and Atmospheric Administration.;https://spo.nmfs.noaa.gov/sites/default/files/tm69.pdf"
 ] .


