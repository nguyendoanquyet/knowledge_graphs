###  http://w3id.org/aqfo/AQFO_00015056
<http://w3id.org/aqfo/AQFO_00015056> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/AQFO_00015055> ;
                                     obo:IAO_0000115 "The larvae emerging from the fertilized eggs after hatching is called hatchling. It is characterized by the presence of yolk sac hanging below from where it draws its nutrition for 2–3 days. At this stage the mouth is not formed and hence it does not take food from outside."@en ;
                                     dc:creator <https://orcid.org/0009-0001-6183-0388> ;
                                     dc:date "2024-03-27T04:53:47Z"^^xsd:dateTime ;
                                     rdfs:label "hatchling"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/AQFO_00015056> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The larvae emerging from the fertilized eggs after hatching is called hatchling. It is characterized by the presence of yolk sac hanging below from where it draws its nutrition for 2–3 days. At this stage the mouth is not formed and hence it does not take food from outside."@en ;
   oboInOwl:hasDbXref "Fish seed rearing manual. (n.d.). Www.fao.org. https://www.fao.org/3/AC381E/AC381E02.htm"
 ] .


###  http://w3id.org/aqfo/AQFO_00015057
<http://w3id.org/aqfo/AQFO_00015057> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/AQFO_00015055> ;
                                     obo:IAO_0000115 "As soon as the yolk sac of the hatchling is absorbed it is known as spawn. At this stage the mouth is formed and it starts taking small zooplankton like rotifers and supplementary feed like egg yolk, finely powdered oil cake, rice bran etc."@en ;
                                     dc:creator <https://orcid.org/0009-0001-6183-0388> ;
                                     dc:date "2024-03-27T04:55:32Z"^^xsd:dateTime ;
                                     rdfs:label "spawn"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/AQFO_00015057> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "As soon as the yolk sac of the hatchling is absorbed it is known as spawn. At this stage the mouth is formed and it starts taking small zooplankton like rotifers and supplementary feed like egg yolk, finely powdered oil cake, rice bran etc."@en ;
   oboInOwl:hasDbXref "Fish seed rearing manual. (n.d.). Www.fao.org. https://www.fao.org/3/AC381E/AC381E02.htm"
 ] .


###  http://w3id.org/aqfo/AQFO_00015058
<http://w3id.org/aqfo/AQFO_00015058> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/AQFO_00015055> ;
                                     obo:IAO_0000115 "a life (growth) stage of fishes that are recently hatched.  This is generally after the yolk sac has been absorbed and almost or entirely disappeared.  At this point, the swim bladder is typically functional and fish can actively feed for themselves.  Depending on the species, this stage can last a few months or more until scales develop.  Fry can be thought of as the “infant” stage for fishes.  Because of their small size at this stage (often only a few centimeters), fry are vulnerable to predation in this stage and need shallow, protected habitat to feed and grow."@en ;
                                     dc:creator <https://orcid.org/0009-0001-6183-0388> ;
                                     dc:date "2024-03-27T05:00:22Z"^^xsd:dateTime ;
                                     oboInOwl:hasExactSynonym "fish larvae" ;
                                     rdfs:label "fry"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/AQFO_00015058> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "a life (growth) stage of fishes that are recently hatched.  This is generally after the yolk sac has been absorbed and almost or entirely disappeared.  At this point, the swim bladder is typically functional and fish can actively feed for themselves.  Depending on the species, this stage can last a few months or more until scales develop.  Fry can be thought of as the “infant” stage for fishes.  Because of their small size at this stage (often only a few centimeters), fry are vulnerable to predation in this stage and need shallow, protected habitat to feed and grow."@en ;
   oboInOwl:hasDbXref "Fry – Fishionary. (2020, February 21). https://fishionary.fisheries.org/fry/"
 ] .


###  http://w3id.org/aqfo/AQFO_00015059
<http://w3id.org/aqfo/AQFO_00015059> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/AQFO_00015055> ;
                                     obo:IAO_0000115 "As soon as the fry grow up to 10–15 cm size or roughly equal the size of a finger it is known as fingerling. Fingerling is the proper size for stocking in table fish production ponds. It takes about 30–60 days for the fry to grow up to fingerling size."@en ;
                                     dc:creator <https://orcid.org/0009-0001-6183-0388> ;
                                     dc:date "2024-03-27T05:04:27Z"^^xsd:dateTime ;
                                     rdfs:label "fingerlings"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/AQFO_00015059> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "As soon as the fry grow up to 10–15 cm size or roughly equal the size of a finger it is known as fingerling. Fingerling is the proper size for stocking in table fish production ponds. It takes about 30–60 days for the fry to grow up to fingerling size."@en ;
   oboInOwl:hasDbXref "Fish seed rearing manual. (n.d.). Www.fao.org. https://www.fao.org/3/AC381E/AC381E02.htm"
 ] .


###  http://w3id.org/aqfo/AQFO_00015060
<http://w3id.org/aqfo/AQFO_00015060> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/AQFO_00015055> ;
                                     obo:IAO_0000115 "or on-growing represents the final rearing stage before harvest and sale. It concerns the stage of fish growth between ± 40 g. to the harvest-size fish of 200 to 800 g., the individual size being determined by market demand. Generally, one can consider that urban markets are looking for fish that exceed 400-450 g. as a minimum market size and many developed2 markets require >600 g."@en ;
                                     dc:creator <https://orcid.org/0009-0001-6183-0388> ;
                                     dc:date "2024-03-27T05:06:54Z"^^xsd:dateTime ;
                                     rdfs:label "fattening"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/AQFO_00015060> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "or on-growing represents the final rearing stage before harvest and sale. It concerns the stage of fish growth between ± 40 g. to the harvest-size fish of 200 to 800 g., the individual size being determined by market demand. Generally, one can consider that urban markets are looking for fish that exceed 400-450 g. as a minimum market size and many developed2 markets require >600 g."@en ;
   oboInOwl:hasDbXref "https://www.nzdl.org/cgi-bin/library?e=d-00000-00---off-0fnl2%2E2--00-0----0-10-0---0---0direct-10---4-------0-1l--11-en-50---20-about---00-0-1-00-0--4----0-0-11-10-0utfZz-8-00&cl=CL1.5&d=HASHdaa7b46b87e58d6ea94561.2.2.3%3e=1"
 ] .


###  http://w3id.org/aqfo/AQFO_00015061
<http://w3id.org/aqfo/AQFO_00015061> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002271> ;
                                     obo:IAO_0000115 "refer to 'live feed' is often used as natural diets for fish larvae in aquaculture. Live feed contains various nutrients such as essential proteins, lipids, carbohydrates, vitamins, minerals, amino acids, and commonly known as living capsules of nutrition."@en ,
                                                     "specialized forms of fish feed designed for the earliest life stages of fish, specifically the larval stage immediately following hatching and the fry stage as they begin to grow."@en ;
                                     dc:creator <https://orcid.org/0009-0001-6183-0388> ;
                                     dc:date "2024-03-27T05:11:55Z"^^xsd:dateTime ;
                                     oboInOwl:hasExactSynonym "larval feeds" ;
                                     rdfs:label "fry feeds"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/AQFO_00015061> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "refer to 'live feed' is often used as natural diets for fish larvae in aquaculture. Live feed contains various nutrients such as essential proteins, lipids, carbohydrates, vitamins, minerals, amino acids, and commonly known as living capsules of nutrition."@en ;
   oboInOwl:hasDbXref "SYUKRI, F., HASSAN, N. H., & AZAMAN, S. N. A. (2022). PERFORMANCES OF FS FEED, ARTEMIA NAUPLII AND COMMERCIAL DIET ON EARLY DEVELOPMENT OF Clarias gariepinus LARVAE. JOURNAL of SUSTAINABILITY SCIENCE and MANAGEMENT, 17(2), 35–45. https://doi.org/10.46754/jssm.2022.02.004"
 ] .


###  http://w3id.org/aqfo/AQFO_00015062
<http://w3id.org/aqfo/AQFO_00015062> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002271> ;
                                     obo:IAO_0000115 "small floating pellets (3 mm in diameter) containing 32 to 36 percent protein. A typical fingerling feed contains soybean meal, cottonseed meal, animal proteins (such as porcine meat and bone meal, meat and bone/blood meal blend, or poultry by-product meal), corn, wheat middlings, animal fat/fish oil, and vitamin and mineral supplements."@en ,
                                                     "specialized types of aquaculture feeds formulated to meet the nutritional needs of young fish, specifically fingerlings (young fish that have developed to about the size of a finger) and juveniles (fish that are in the stage between fingerlings and adults). These feeds are designed to promote healthy growth and development during the early life stages of fish." ;
                                     dc:creator <https://orcid.org/0009-0001-6183-0388> ;
                                     dc:date "2024-03-27T05:16:18Z"^^xsd:dateTime ;
                                     oboInOwl:hasExactSynonym "juvenile feeds" ;
                                     rdfs:label "fingerlings feeds"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/AQFO_00015062> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "small floating pellets (3 mm in diameter) containing 32 to 36 percent protein. A typical fingerling feed contains soybean meal, cottonseed meal, animal proteins (such as porcine meat and bone meal, meat and bone/blood meal blend, or poultry by-product meal), corn, wheat middlings, animal fat/fish oil, and vitamin and mineral supplements."@en ;
   oboInOwl:hasDbXref "Li, M., & Robinson, E. (2013). Feed Ingredients and Feeds for Channel Catfish. https://www.uapb.edu/sites/www/Uploads/Pond%20Management/Resources/SRAC%201806%20Feed%20Ingredients%20and%20Feeds%20for%20Channel%20Catfish.pdf"
 ] .


###  http://w3id.org/aqfo/AQFO_00015063
<http://w3id.org/aqfo/AQFO_00015063> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://w3id.org/aqfo/aqfo_00002271> ;
                                     obo:IAO_0000115 "Fattening fish feeds are specialized formulations designed to rapidly increase the weight and size of farmed fish, optimizing them for market sale or further breeding purposes." ,
                                                     "Larger fingerlings are fed small floating pellets (1/8 inch diameter) containing 35 percent protein. Advanced fingerlings (5-6 inches) and food fish are generally fed a floating feed of approximately 5/32 - 3/16 inch in diameter containing 28-32 percent protein."@en ;
                                     dc:creator <https://orcid.org/0009-0001-6183-0388> ;
                                     dc:date "2024-03-27T05:20:41Z"^^xsd:dateTime ;
                                     rdfs:label "fattening feeds"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://w3id.org/aqfo/AQFO_00015063> ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Larger fingerlings are fed small floating pellets (1/8 inch diameter) containing 35 percent protein. Advanced fingerlings (5-6 inches) and food fish are generally fed a floating feed of approximately 5/32 - 3/16 inch in diameter containing 28-32 percent protein."@en ;
   oboInOwl:hasDbXref "Nutrition, Feeds, and Feeding. (n.d.). Extension.msstate.edu. Retrieved March 27, 2024, from http://extension.msstate.edu/agriculture/catfish/nutrition-feeds-and-feeding"
 ] .


