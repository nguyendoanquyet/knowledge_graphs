###  http://purl.obolibrary.org/obo/RO_0002416
obo:RO_0002416 rdf:type owl:AnnotationProperty ;
               obo:IAO_0000115 "An assertion that involves at least one OWL object that is intended to be expanded into one or more logical axioms. The logical expansion can yield axioms expressed using any formal logical system, including, but not limited to OWL2-DL." ;
               obo:IAO_0000412 "http://purl.obolibrary.org/obo/ro.owl" ;
               rdfs:label "logical macro assertion"@en ;
               rdfs:seeAlso "http://purl.obolibrary.org/obo/ro/docs/shortcut-relations/"^^xsd:anyURI .


###  http://purl.obolibrary.org/obo/RO_0002421
obo:RO_0002421 rdf:type owl:AnnotationProperty ;
               obo:IAO_0000115 "A logical macro assertion whose domain is an IRI for a property" ;
               obo:IAO_0000412 "http://purl.obolibrary.org/obo/ro.owl" ;
               rdfs:label "logical macro assertion on a property"@en ;
               rdfs:subPropertyOf obo:RO_0002416 .


###  http://purl.obolibrary.org/obo/RO_0002422
obo:RO_0002422 rdf:type owl:AnnotationProperty ;
               obo:IAO_0000115 "Used to annotate object properties to describe a logical meta-property or characteristic of the object property." ;
               obo:IAO_0000412 "http://purl.obolibrary.org/obo/ro.owl" ;
               rdfs:label "logical macro assertion on an object property"@en ;
               rdfs:subPropertyOf obo:RO_0002421 .


###  http://purl.obolibrary.org/obo/RO_0002423
obo:RO_0002423 rdf:type owl:AnnotationProperty ;
               obo:IAO_0000412 "http://purl.obolibrary.org/obo/ro.owl" ;
               rdfs:label "logical macro assertion on an annotation property"@en ;
               rdfs:subPropertyOf obo:RO_0002421 .


###  http://purl.obolibrary.org/obo/RO_0002575
obo:RO_0002575 rdf:type owl:AnnotationProperty ;
               obo:IAO_0000115 "relation p is the direct form of relation q iff p is a subPropertyOf q, p does not have the Transitive characteristic, q does have the Transitive characteristic, and for all x, y: x q y -> exists z1, z2, ..., zn such that x p z1 ... z2n y" ;
               obo:IAO_0000116 """The general property hierarchy is:
  \"directly P\" SubPropertyOf \"P\"
  Transitive(P)
Where we have an annotation assertion
  \"directly P\" \"is direct form of\" \"P\"""" ;
               obo:IAO_0000412 "http://purl.obolibrary.org/obo/ro.owl" ;
               obo:ONTONEO_10000002 "Fernanda Farinelli"@pt-br ;
               obo:RO_0002423 "If we have the annotation P is-direct-form-of Q, and we have inverses P' and Q', then it follows that P' is-direct-form-of Q'" ;
               terms:creator <https://orcid.org/0000-0002-6601-2165> ;
               rdfs:label ""@pt-br ,
                          "is direct form of" ;
               rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/direct-and-indirect-relations/> ;
               rdfs:subPropertyOf obo:RO_0002422 .


###  http://purl.obolibrary.org/obo/RO_0002580
obo:RO_0002580 rdf:type owl:AnnotationProperty ;
               obo:IAO_0000412 "http://purl.obolibrary.org/obo/ro.owl" ;
               rdfs:label "logical macro assertion on an axiom" ;
               rdfs:subPropertyOf obo:RO_0002416 .


###  http://purl.obolibrary.org/obo/RO_0002581
obo:RO_0002581 rdf:type owl:AnnotationProperty ;
               obo:IAO_0000115 "If R <- P o Q is a defining property chain axiom, then it also holds that R -> P o Q. Note that this cannot be expressed directly in OWL" ;
               obo:IAO_0000412 "http://purl.obolibrary.org/obo/ro.owl" ;
               rdfs:label "is a defining property chain axiom" ;
               rdfs:subPropertyOf obo:RO_0002580 .


###  http://purl.obolibrary.org/obo/RO_0002582
obo:RO_0002582 rdf:type owl:AnnotationProperty ;
               obo:IAO_0000115 "If R <- P o Q is a defining property chain axiom, then (1) R -> P o Q holds and (2) Q is either reflexive or locally reflexive. A corollary of this is that P SubPropertyOf R." ;
               obo:IAO_0000412 "http://purl.obolibrary.org/obo/ro.owl" ;
               rdfs:label "is a defining property chain axiom where second argument is reflexive" ;
               rdfs:subPropertyOf obo:RO_0002581 .


