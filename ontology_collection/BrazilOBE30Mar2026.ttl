                obo:IAO_0000117 "Bjoern Peters, Alan Ruttenberg, Helen Parkinson"@en ;
                obo:IAO_0000118 "material procurement" ;
                obo:IAO_0000119 "IEDB"@en ;
                obo:IAO_0000412 "http://purl.obolibrary.org/obo/obi/2024-06-10/obi_core.owl" ;
                obo:ONTONEO_10000002 "Fernanda Farinelli"@pt-br ;
                rdfs:label "aquisição de material"@pt-br ,
                           "material acquisition"@en .


