                                        obo:BFO_0000051
                                      ) ;
               obo:IAO_0000112 "a particular instances of akt-2 enables some instance of protein kinase activity" ;
               obo:IAO_0000115 "c enables p iff c is capable of p and c acts to execute p." ;
