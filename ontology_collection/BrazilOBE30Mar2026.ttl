###  http://purl.obolibrary.org/obo/RO_0002232
obo:RO_0002232 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002479 ;
               rdfs:domain obo:BFO_0000015 ;
               rdfs:range obo:BFO_0000004 ;
