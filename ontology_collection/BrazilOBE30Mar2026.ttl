                obo:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
                obo:IAO_0000412 "http://purl.obolibrary.org/obo/iao/2022-11-07/iao.owl" ;
                obo:ONTONEO_10000002 "Fernanda Farinelli"@pt-br ;
