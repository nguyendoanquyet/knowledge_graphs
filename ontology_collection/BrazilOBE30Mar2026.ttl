###  http://purl.obolibrary.org/obo/OBI_0002135
obo:OBI_0002135 rdf:type owl:DatatypeProperty ;
                obo:IAO_0000115 "A relation between a value specification and a literal." ;
                obo:IAO_0000116 "This is not an RDF/OWL object property. It is intended to link a value found in e.g. a database column of 'M' (the literal) to an instance of a value specification class, which can then be linked to indicate that this is about the biological gender of a human subject."@en ;
                obo:IAO_0000119 "OBI"@en ;
                obo:IAO_0000412 "http://purl.obolibrary.org/obo/obi/2024-06-10/obi.owl" ;
                rdfs:label "has specified value"@en .


