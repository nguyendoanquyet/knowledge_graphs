###  http://purl.obolibrary.org/obo/OBI_0000828
obo:OBI_0000828 rdf:type owl:Class ;
                rdfs:subClassOf obo:OBI_0000245 ;
                obo:IAO_0000112 "The SALK institute is a research organization."@en ;
                obo:IAO_0000115 "An organization formed with a goal to have its members conduct investigations"@en ;
                obo:IAO_0000117 "Bjoern Peters" ;
