@prefix focosa-f: <https://dbwis.gitlab.io/focosa/src/modules/health-nutrition/food#> .
@prefix focosa-h: <https://dbwis.gitlab.io/focosa/src/modules/health-nutrition/health#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foodon: <http://purl.obolibrary.org/obo/FOODON_> .
@prefix snomed: <http://purl.bioontology.org/ontology/SNOMEDCT/> .

focosa-f:Ontology a owl:Ontology ;
    <http://purl.org/dc/elements/1.1/creator> "Ada Bagozi, Devis Bianchini, Massimiliano Garda, Michele Melchiori, Stefano Picchi, Anisa Rula" ;
    <http://purl.org/dc/elements/1.1/contributor> "" ;
    owl:versionIRI <https://dbwis.gitlab.io/focosa/> ;
    <http://purl.org/dc/elements/1.1/publisher> "UNIBS" ;
    <http://purl.org/dc/elements/1.1/title> "FoCOSA ontology  - Health Nutrition Module" ;
    <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
    <http://purl.org/vocab/vann/preferredNamespacePrefix> "focosa-h" ;
    <http://purl.org/vocab/vann/preferredNamespaceUri> "https://dbwis.gitlab.io/focosa/src/modules/health-nutrition" ;
    owl:versionInfo "1.0.0" .

focosa-f:FoodItem a owl:Class ;
    rdfs:label "Food Item" ;
    rdfs:comment "Represents an individual food item." ;
    rdfs:subClassOf foodon:00001002 .

focosa-f:FoodCategory a owl:Class ;
    rdfs:label "Food Categories" ;
    rdfs:comment "Represents various categories of food items." ;
    rdfs:subClassOf foodon:03400690 .

focosa-f:Dairy a owl:Class ;
    rdfs:label "Dairy" ;
    rdfs:comment "Represents dairy products." ;
    rdfs:subClassOf focosa-f:FoodCategory .

focosa-f:Fruits a owl:Class ;
    rdfs:label "Fruits" ;
    rdfs:comment "Represents fruit products." ;
    rdfs:subClassOf focosa-f:FoodCategory ;
    rdfs:subClassOf foodon:03400707 . # 17 fruits

focosa-f:Eggs a owl:Class ;
    rdfs:label "Eggs" ;
    rdfs:comment "Represents eggs products." ;
    rdfs:subClassOf focosa-f:FoodCategory ;
    rdfs:subClassOf foodon:03400718 . # 28 eggs

focosa-f:Pulses a owl:Class ;
    rdfs:label "Pulses" ;
    rdfs:comment "Represents pulses products." ;
    rdfs:subClassOf focosa-f:FoodCategory ;
    rdfs:subClassOf foodon:03400704 . # 14 pulses

focosa-f:Nuts a owl:Class ;
    rdfs:label "Nuts" ;
    rdfs:comment "Represents nuts products." ;
    rdfs:subClassOf focosa-f:FoodCategory ;
    rdfs:subClassOf foodon:03400703 . # 13 nuts

focosa-f:Coffee a owl:Class ;
    rdfs:label "Coffee, tea, cocoa powder" ;
    rdfs:comment "Represents coffee, tea, cocoa powder products." ;
    rdfs:subClassOf focosa-f:FoodCategory ;
    rdfs:subClassOf foodon:03400710 . # 20 coffee, tea, cocoa powder

focosa-f:Miscelleneous a owl:Class ;
    rdfs:label "Miscellaneous foods" ;
    rdfs:comment "Represents miscellaneous foods products." ;
    rdfs:subClassOf focosa-f:FoodCategory ;
    rdfs:subClassOf foodon:03400722 . #32 miscellaneous foods

focosa-f:Vegetables a owl:Class ;
    rdfs:label "Vegetables" ;
    rdfs:comment "Represents vegetable products." ;
    rdfs:subClassOf focosa-f:FoodCategory .

focosa-f:Fishes a owl:Class ;
    rdfs:label "Fishes" ;
    rdfs:comment "Represents fishes products." ;
    rdfs:subClassOf focosa-f:FoodCategory ;
    rdfs:subClassOf foodon:03400717 . #27 fish and seafood
    
focosa-f:Meat a owl:Class ;
    rdfs:label "Meat" ;
    rdfs:comment "Represents meat products." ;
    rdfs:subClassOf focosa-f:FoodCategory .

focosa-f:Pork a owl:Class ;
    rdfs:label "Pork" ;
    rdfs:comment "Represents pork meat products." ;
    rdfs:subClassOf focosa-f:Meat .

focosa-f:Poultry a owl:Class ;
    rdfs:label "Poultry" ;
    rdfs:comment "Represents poultry meat products." ;
    rdfs:subClassOf focosa-f:Meat .

focosa-f:Chicken a owl:Class ;
    rdfs:label "Chicken" ;
    rdfs:comment "Represents poultry chicken products." ;
    rdfs:subClassOf focosa-f:Poultry .

focosa-f:NutritionInformation a owl:Class ;
    rdfs:label "Nutrition Information" ;
    rdfs:comment "Represents nutritional information of food items." .

focosa-f:Carbohydrates a owl:Class ;
    rdfs:label "Carbohydrates" ;
    rdfs:comment "Represents the carbohydrate content in food." ;
    rdfs:subClassOf focosa-f:NutritionInformation .

focosa-f:Fat a owl:Class ;
    rdfs:label "Fat" ;
    rdfs:comment "Represents the fat content in food." ;
    rdfs:subClassOf focosa-f:NutritionInformation .

focosa-f:Protein a owl:Class ;
    rdfs:label "Protein" ;
    rdfs:comment "Represents the protein content in food." ;
    rdfs:subClassOf focosa-f:NutritionInformation .

focosa-h:RestrictedDiet a owl:Class ;
    rdfs:label "Restricted Diet" ;
    owl:equivalentClass schema:RestrictedDiet ;
    rdfs:comment "Represents different types of restricted diets." .

schema:DiabeticDiet a owl:Class ;
    rdfs:label "Diabetic Diet" ;
    rdfs:comment "Represents a diet suitable for diabetic individuals." ;
    rdfs:subClassOf focosa-h:RestrictedDiet .

schema:GlutenFreeDiet a owl:Class ;
    rdfs:label "Gluten Free Diet" ;
    rdfs:comment "Represents a diet free from gluten." ;
    rdfs:subClassOf focosa-h:RestrictedDiet .

schema:ReligiousDiet a owl:Class ;
    rdfs:label "Religious Diet" ;
    rdfs:comment "Represents a diet based on religious guidelines." ;
    rdfs:subClassOf focosa-h:RestrictedDiet .

schema:VeganDiet a owl:Class ;
    rdfs:label "Vegan Diet" ;
    rdfs:comment "Represents a diet free from animal products." ;
    rdfs:subClassOf focosa-h:RestrictedDiet .

schema:VegetarianDiet a owl:Class ;
    rdfs:label "Vegetarian Diet" ;
    rdfs:comment "Represents a diet free from meat products." ;
    rdfs:subClassOf focosa-h:RestrictedDiet .

schema:HalalDiet a owl:Class ;
    rdfs:label "Halal Diet" ;
    rdfs:comment "Represents a diet that follows Islamic dietary laws." ;
    rdfs:subClassOf schema:ReligiousDiet .

schema:HinduDiet a owl:Class ;
    rdfs:label "Hindu Diet" ;
    rdfs:comment "Represents a diet that follows Hindu dietary customs." ;
    rdfs:subClassOf schema:ReligiousDiet .

schema:KosherDiet a owl:Class ;
    rdfs:label "Kosher Diet" ;
    rdfs:comment "Represents a diet that follows Jewish dietary laws." ;
    rdfs:subClassOf schema:ReligiousDiet .

focosa-h:MedicalCondition a owl:Class ;
    rdfs:label "Health Conditions" ;
    rdfs:comment "Represents health-related information." ;
    owl:equivalentClass schema:MedicalCondition .

focosa-h:FoodAllergy a owl:Class ;
    rdfs:label "Food Allergy" ;
    rdfs:comment "Represents various food allergies." ;
    rdfs:subClassOf focosa-h:MedicalCondition ;
    owl:equivalentClass snomed:414285001 .

focosa-h:EggAllergy a owl:Class ;
    rdfs:label "Egg Allergy" ;
    rdfs:comment "Represents an allergy to eggs." ;
    rdfs:subClassOf focosa-h:FoodAllergy ;
    owl:equivalentClass snomed:213020009 .

focosa-h:GlutenAllergy a owl:Class ;
    rdfs:label "Gluten Allergy" ;
    rdfs:comment "Represents an allergy to gluten." ;
    rdfs:subClassOf focosa-h:FoodAllergy ;
    owl:equivalentClass snomed:1269425007 .

focosa-h:MilkAllergy a owl:Class ;
    rdfs:label "Milk Allergy" ;
    rdfs:comment "Represents an allergy to milk." ;
    rdfs:subClassOf focosa-h:FoodAllergy ;
    owl:equivalentClass snomed:782555009 .

focosa-h:NutsAllergy a owl:Class ;
    rdfs:label "Nuts Allergy" ;
    rdfs:comment "Represents an allergy to nuts." ;
    rdfs:subClassOf focosa-h:FoodAllergy ;
    owl:equivalentClass snomed:91934008 .

focosa-h:SeafoodAllergy a owl:Class ;
    rdfs:label "Seafood Allergy" ;
    rdfs:comment "Represents an allergy to seafood." ;
    rdfs:subClassOf focosa-h:FoodAllergy ;
    owl:equivalentClass snomed:91937001 .

focosa-h:FoodIntolerance a owl:Class ;
    rdfs:label "Food Intolerance" ;
    rdfs:comment "Represents various food intolerances." ;
    rdfs:subClassOf focosa-h:MedicalCondition ;
    owl:equivalentClass snomed:235719002 . 

focosa-h:GlutenIntolerance a owl:Class ;
    rdfs:label "Gluten Intolerance" ;
    rdfs:comment "Represents an intolerance to gluten." ;
    rdfs:subClassOf focosa-h:FoodIntolerance ;
    owl:equivalentClass snomed:1269424006 . 
    
focosa-h:LactoseIntolerance a owl:Class ;
    rdfs:label "Lactose Intolerance" ;
    rdfs:comment "Represents an intolerance to lactose." ;
    rdfs:subClassOf focosa-h:FoodIntolerance ;
    owl:equivalentClass snomed:782415009 .

focosa-h:Pathology a owl:Class ;
    rdfs:label "Pathology" ;
    rdfs:comment "Represents various pathologies." ;
    rdfs:subClassOf focosa-h:MedicalCondition ; 
    owl:equivalentClass snomed:394595002 . 
    
focosa-f:belongsToCategory a owl:ObjectProperty ;
    rdfs:label "belongs to category" ;
    rdfs:comment "Relates a food item to its category." ;
    rdfs:domain focosa-f:FoodItem ;
    rdfs:range focosa-f:FoodCategory .

focosa-f:hasNutritionalInformation a owl:ObjectProperty ;
    rdfs:label "has nutritional information" ;
    rdfs:comment "Relates a food item to its nutritional information." ;
    rdfs:domain focosa-f:FoodItem ;
    rdfs:range focosa-f:NutritionInformation .

focosa-h:meetHealthRequirements a owl:ObjectProperty ;
    rdfs:label "meets health requirements" ;
    rdfs:comment "Specifies health requirements met by a restricted diet." ;
    rdfs:domain focosa-h:RestrictedDiet ;
    rdfs:range focosa-h:MedicalCondition .

focosa-h:suitableFor a owl:ObjectProperty ;
    rdfs:label "suitable for" ;
    rdfs:comment "Specifies the food category suitable for medical condition." ;
    rdfs:domain focosa-f:FoodItem ;
    rdfs:range focosa-h:MedicalCondition .

schema:suitableForDiet a owl:ObjectProperty ;
    rdfs:label "suitable for diet" ;
    rdfs:comment "Relates a food item to its suitable diet." ;
    rdfs:domain focosa-f:FoodCategory ;
    rdfs:range focosa-h:RestrictedDiet .

focosa-f:hasValue a owl:DatatypeProperty ;
    rdfs:label "has value" ;
    rdfs:comment "Specifies the value of the nutrient of the food item." ;
    rdfs:domain focosa-f:NutritionInformation ;
    rdfs:range xsd:float .

focosa-h:Alzheimer a focosa-h:Pathology ;
    rdfs:label "Alzheimer's disease" ;
    rdfs:comment "A chronic neurodegenerative disease that affects memory and other cognitive functions." .

focosa-f:Omega3 a owl:Class ;
    rdfs:label "Omega3" ;
    rdfs:comment "Represents the omega3 content in food." ;
    rdfs:subClassOf focosa-f:NutritionInformation .